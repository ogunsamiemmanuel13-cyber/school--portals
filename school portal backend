import React, { useState, useEffect } from 'react';
import axios from 'axios';

// CHANGE THIS TO YOUR RENDER BACKEND URL LATER
const API_URL = 'localhost:8000'; 

function App() {
  const [students, setStudents] = useState([]);
  const [newStudent, setNewStudent] = useState({ name: '', grade: '' });

  // Fetch students on load
  useEffect(() => {
    fetchStudents();
  }, []);

  const fetchStudents = async () => {
    try {
      const res = await axios.get(${API_URL}/students);
      setStudents(res.data);
    } catch (err) {
      console.error("Error fetching students:", err);
    }
  };

  const handleAddStudent = async (e) => {
    e.preventDefault();
    if (!newStudent.name || !newStudent.grade) return;

    try {
      await axios.post(${API_URL}/students, newStudent);
      setNewStudent({ name: '', grade: '' });
      fetchStudents(); // Refresh list
    } catch (err) {
      console.error("Error adding student:", err);
    }
  };

  return (
    <div style={{ padding: '20px', fontFamily: 'Arial' }}>
      <h1>School Portal</h1>
      
      <form onSubmit={handleAddStudent} style={{ marginBottom: '20px' }}>
        <input 
          type="text" 
          placeholder="Student Name" 
          value={newStudent.name}
          onChange={(e) => setNewStudent({...newStudent, name: e.target.value})}
          style={{ padding: '8px', marginRight: '10px' }}
        />
        <input 
          type="text" 
          placeholder="Grade" 
          value={newStudent.grade}
          onChange={(e) => setNewStudent({...newStudent, grade: e.target.value})}
          style={{ padding: '8px', marginRight: '10px' }}
        />
        <button type="submit" style={{ padding: '8px 16px' }}>Add Student</button>
      </form>

      <h2>Students List</h2>
      <ul>
        {students.map(student => (
          <li key={student.id}>
            {student.name} - Grade: {student.grade}
          </li>
        ))}
      </ul>
    </div>
  );
}

export default App;

